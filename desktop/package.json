{
  "name": "local-canvas-desktop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Local-first Excalidraw desktop workspace",
  "author": "Local Canvas contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/notices.mjs && vite build && node scripts/assets.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:e2e": "node tests/desktop.e2e.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "prettier": "3.9.10",
    "vite": "8.3.4"
  },
  "overrides": {
    "nanoid@3.3.3": "3.3.20",
    "nanoid@4.0.2": "5.1.16",
    "lodash-es": "4.18.1",
    "sass": "1.105.2"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.localcanvas.desktop",
    "productName": "Local Canvas",
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
